{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/algotradinglife/paired-trading/doc/schemas/pa_feitian_evaluation_screening_report_v1.schema.json",
  "title": "PA / Feitian M6 Evaluation Screening Report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "provenance", "evaluation_dataset", "aggregate_result", "candidates", "warnings"],
  "properties": {"schema_version": {"const": "pa_feitian_evaluation_screening_report_v1"}, "generated_at_utc": {"type": "string", "format": "date-time"}, "provenance": {"$ref": "#/$defs/provenance"}, "evaluation_dataset": {"$ref": "#/$defs/dataset_ref"}, "aggregate_result": {"$ref": "#/$defs/aggregate_ref"}, "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}, "multiple_comparison": {"anyOf": [{"$ref": "#/$defs/multiple_comparison"}, {"type": "null"}]}, "warnings": {"type": "array", "items": {"type": "string"}}},
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "hash_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["role", "source_manifest_path", "source_manifest_sha256", "source_manifest_schema_version", "premium_outcome_artifact_path", "premium_outcome_artifact_sha256", "premium_outcome_schema_version", "source_commit", "producer", "cli_args", "policy_config_sha256", "data_access_status", "fixture_fallback", "random_seed", "input_hashes", "output_hashes", "notes"], "properties": {"role": {"const": "m6_screening_report"}, "source_manifest_path": {"type": "string"}, "source_manifest_sha256": {"$ref": "#/$defs/hash"}, "source_manifest_schema_version": {"const": "pa_feitian_run_manifest_v1"}, "premium_outcome_artifact_path": {"type": "string"}, "premium_outcome_artifact_sha256": {"$ref": "#/$defs/hash"}, "premium_outcome_schema_version": {"const": "pa_feitian_premium_outcome_v1"}, "source_commit": {"type": "string", "minLength": 7, "maxLength": 40}, "producer": {"type": "string"}, "cli_args": {"type": "array", "items": {"type": "string"}}, "policy_config_sha256": {"$ref": "#/$defs/hash"}, "data_access_status": {"enum": ["real_data_available", "fixture_fallback", "data_blocked", "unknown"]}, "fixture_fallback": {"type": "boolean"}, "random_seed": {"type": ["integer", "null"]}, "input_hashes": {"$ref": "#/$defs/hash_map"}, "output_hashes": {"$ref": "#/$defs/hash_map"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "dataset_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "schema_version", "content_type"], "properties": {"kind": {"const": "evaluation_dataset"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"const": "pa_feitian_evaluation_dataset_v1"}, "content_type": {"const": "application/json"}}},
    "aggregate_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "schema_version", "content_type"], "properties": {"kind": {"const": "evaluation_aggregate_result"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"const": "pa_feitian_evaluation_aggregate_result_v1"}, "content_type": {"const": "application/json"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "policy_id", "policy_version", "classification", "classification_basis", "comparable_oos_window_count", "effective_event_count", "baseline_policy_id", "reviewer_status", "limitations"], "properties": {"candidate_id": {"type": "string"}, "policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "classification": {"enum": ["promising", "inconclusive", "negative", "blocked"]}, "classification_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "comparable_oos_window_count": {"type": "integer", "minimum": 0}, "effective_event_count": {"type": "integer", "minimum": 0}, "baseline_policy_id": {"type": "string"}, "reviewer_status": {"enum": ["pending", "approved", "changes_requested", "rejected"]}, "limitations": {"type": "array", "items": {"type": "string"}}, "comparison": {"anyOf": [{"$ref": "#/$defs/comparison"}, {"type": "null"}]}}},
    "ci": {"type": "object", "additionalProperties": false, "required": ["confidence_level", "lower", "upper", "method", "cluster_unit"], "properties": {"confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}, "method": {"type": "string", "minLength": 1}, "cluster_unit": {"enum": ["event", "date", "none"]}}},
    "oos_window": {"type": "object", "additionalProperties": false, "required": ["fold_id", "effective_event_count", "mean_premium_r_difference", "result_status", "notes"], "properties": {"fold_id": {"type": "string"}, "effective_event_count": {"type": "integer", "minimum": 0}, "mean_premium_r_difference": {"type": ["number", "null"]}, "result_status": {"enum": ["generated", "insufficient_sample", "blocked"]}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["comparability_status", "baseline_dataset_sha256", "candidate_dataset_sha256", "baseline_aggregate_sha256", "candidate_aggregate_sha256", "paired_effective_event_count", "baseline_mean_premium_r", "candidate_mean_premium_r", "mean_premium_r_difference", "median_premium_r_difference", "adjusted_bootstrap_ci", "comparable_oos_windows", "limitations"], "properties": {"comparability_status": {"enum": ["comparable", "insufficient_sample", "blocked"]}, "baseline_dataset_sha256": {"$ref": "#/$defs/hash"}, "candidate_dataset_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "baseline_aggregate_sha256": {"$ref": "#/$defs/hash"}, "candidate_aggregate_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "paired_effective_event_count": {"type": "integer", "minimum": 0}, "baseline_mean_premium_r": {"type": ["number", "null"]}, "candidate_mean_premium_r": {"type": ["number", "null"]}, "mean_premium_r_difference": {"type": ["number", "null"]}, "median_premium_r_difference": {"type": ["number", "null"]}, "adjusted_bootstrap_ci": {"anyOf": [{"$ref": "#/$defs/ci"}, {"type": "null"}]}, "comparable_oos_windows": {"type": "array", "items": {"$ref": "#/$defs/oos_window"}}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "multiple_comparison": {"type": "object", "additionalProperties": false, "required": ["configuration_sha256", "method", "family_size", "alpha", "adjusted_confidence_level", "tested_candidate_count", "unavailable_candidate_count"], "properties": {"configuration_sha256": {"$ref": "#/$defs/hash"}, "method": {"const": "bonferroni"}, "family_size": {"type": "integer", "minimum": 1}, "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "adjusted_confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "tested_candidate_count": {"type": "integer", "minimum": 0}, "unavailable_candidate_count": {"type": "integer", "minimum": 0}}}
  }
}
