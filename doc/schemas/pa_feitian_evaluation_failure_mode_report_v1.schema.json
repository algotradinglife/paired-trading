{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/algotradinglife/paired-trading/doc/schemas/pa_feitian_evaluation_failure_mode_report_v1.schema.json",
  "title": "PA / Feitian M6 Evaluation Failure-mode Report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "provenance", "evaluation_dataset", "failure_modes", "warnings"],
  "properties": {"schema_version": {"const": "pa_feitian_evaluation_failure_mode_report_v1"}, "generated_at_utc": {"type": "string", "format": "date-time"}, "provenance": {"$ref": "#/$defs/provenance"}, "evaluation_dataset": {"$ref": "#/$defs/dataset_ref"}, "failure_modes": {"type": "array", "items": {"$ref": "#/$defs/failure_mode"}}, "warnings": {"type": "array", "items": {"type": "string"}}},
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "hash_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["role", "source_manifest_path", "source_manifest_sha256", "source_manifest_schema_version", "premium_outcome_artifact_path", "premium_outcome_artifact_sha256", "premium_outcome_schema_version", "source_commit", "producer", "cli_args", "policy_config_sha256", "data_access_status", "fixture_fallback", "random_seed", "input_hashes", "output_hashes", "notes"], "properties": {"role": {"const": "m6_failure_mode_report"}, "source_manifest_path": {"type": "string"}, "source_manifest_sha256": {"$ref": "#/$defs/hash"}, "source_manifest_schema_version": {"const": "pa_feitian_run_manifest_v1"}, "premium_outcome_artifact_path": {"type": "string"}, "premium_outcome_artifact_sha256": {"$ref": "#/$defs/hash"}, "premium_outcome_schema_version": {"const": "pa_feitian_premium_outcome_v1"}, "source_commit": {"type": "string", "minLength": 7, "maxLength": 40}, "producer": {"type": "string"}, "cli_args": {"type": "array", "items": {"type": "string"}}, "policy_config_sha256": {"$ref": "#/$defs/hash"}, "data_access_status": {"enum": ["real_data_available", "fixture_fallback", "data_blocked", "unknown"]}, "fixture_fallback": {"type": "boolean"}, "random_seed": {"type": ["integer", "null"]}, "input_hashes": {"$ref": "#/$defs/hash_map"}, "output_hashes": {"$ref": "#/$defs/hash_map"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "dataset_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "schema_version", "content_type"], "properties": {"kind": {"const": "evaluation_dataset"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"const": "pa_feitian_evaluation_dataset_v1"}, "content_type": {"const": "application/json"}}},
    "failure_mode": {"type": "object", "additionalProperties": false, "required": ["failure_mode_id", "category", "label", "affected_row_count", "outcome_ids", "source_signal_ids", "input_refs", "severity", "notes"], "properties": {"failure_mode_id": {"type": "string"}, "category": {"enum": ["decision_trace", "iv_gate", "option_leg", "data_quality", "exit_reason", "premium_underlying_divergence", "policy_instability", "other"]}, "label": {"type": "string"}, "affected_row_count": {"type": "integer", "minimum": 0}, "outcome_ids": {"type": "array", "items": {"type": "string"}}, "source_signal_ids": {"type": "array", "items": {"type": "string"}}, "input_refs": {"type": "array", "items": {"type": "string"}}, "severity": {"enum": ["info", "warning", "blocking"]}, "notes": {"type": "array", "items": {"type": "string"}}}}
  }
}
