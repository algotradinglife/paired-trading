{
  "$defs": {
    "AmplitudeSide": {
      "additionalProperties": false,
      "properties": {
        "reference_value": {
          "title": "Reference Value",
          "type": "number"
        },
        "candidate_value": {
          "title": "Candidate Value",
          "type": "number"
        },
        "decay_ratio": {
          "title": "Decay Ratio",
          "type": "number"
        }
      },
      "required": [
        "reference_value",
        "candidate_value",
        "decay_ratio"
      ],
      "title": "AmplitudeSide",
      "type": "object"
    },
    "CrossLevelSummaryDTO": {
      "additionalProperties": false,
      "description": "Pydantic mirror of dataclass CrossLevelSummary.",
      "properties": {
        "alignment_strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Alignment Strength",
          "type": "number"
        },
        "dominant_trend": {
          "title": "Dominant Trend",
          "type": "string"
        },
        "primary_label": {
          "title": "Primary Label",
          "type": "string"
        },
        "primary_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Primary Confidence",
          "type": "number"
        },
        "secondary_labels": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Secondary Labels",
          "type": "array"
        }
      },
      "required": [
        "alignment_strength",
        "dominant_trend",
        "primary_label",
        "primary_confidence",
        "secondary_labels"
      ],
      "title": "CrossLevelSummaryDTO",
      "type": "object"
    },
    "DivergenceSignal": {
      "additionalProperties": false,
      "description": "One detected divergence event.\n\nEach emitted on completion of a candidate container that, compared with\nits reference, produces a non-trivial result (standard / weakness / hidden).\nNon-divergence events (candidate exceeds reference) trigger reference\nresets internally \u2014 they're not emitted as signals.",
      "properties": {
        "level": {
          "enum": [
            "intra_cycle",
            "inter_cycle",
            "inter_segment"
          ],
          "title": "Level",
          "type": "string"
        },
        "subtype": {
          "enum": [
            "standard",
            "weakness",
            "hidden"
          ],
          "title": "Subtype",
          "type": "string"
        },
        "direction": {
          "enum": [
            "top",
            "bottom"
          ],
          "title": "Direction",
          "type": "string"
        },
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "candidate_bar_idx": {
          "title": "Candidate Bar Idx",
          "type": "integer"
        },
        "reference_bar_idx": {
          "title": "Reference Bar Idx",
          "type": "integer"
        },
        "container_type": {
          "enum": [
            "heap",
            "cycle",
            "segment"
          ],
          "title": "Container Type",
          "type": "string"
        },
        "container_segment_id": {
          "title": "Container Segment Id",
          "type": "integer"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "integer"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "integer"
        },
        "price_side": {
          "$ref": "#/$defs/PriceSide"
        },
        "amplitude_side": {
          "$ref": "#/$defs/AmplitudeSide"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "is_continuous_gap": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Continuous Gap"
        },
        "multi_tf_context": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multi Tf Context"
        },
        "context_features": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Features"
        }
      },
      "required": [
        "level",
        "subtype",
        "direction",
        "level_id",
        "timestamp",
        "candidate_bar_idx",
        "reference_bar_idx",
        "container_type",
        "container_segment_id",
        "reference_id",
        "candidate_id",
        "price_side",
        "amplitude_side",
        "confidence"
      ],
      "title": "DivergenceSignal",
      "type": "object"
    },
    "ExhaustionEvent": {
      "additionalProperties": false,
      "description": "One trend-exhaustion reversal candidate.\n\nLifecycle: emitted on a bar where an in-progress MACD segment has run\nlong enough (T1), multi-TF context is aligned same-direction trending\n(T2), the bar both sits at the segment extreme (T4) and shows a\nBrooks-style reversal candle (T3). A subsequent bar exceeding this bar's\nextreme means the candidate did not turn the trend (false positive in\nretrospect).\n\nField guarantees (envelope schema 1.4):\n  - level_id, timestamp: emitting TF identification (UTC)\n  - candidate_bar_idx: position in the primary_bars frame the detector\n    was given (zero-based, post reset_index)\n  - direction: predicted reversal direction (opposite of segment)\n  - segment_id, segment_direction, bars_in_segment: segment context\n  - n_completed_cycles: count of cycles fully closed within this segment\n    BEFORE/INCLUDING this bar\n  - wick_ratio: rejection-side wick / bar range, clipped [0, 1]\n  - body_half: where the close sits within the bar range\n  - volume_ratio: bar volume / trailing-{VOLUME_LOOKBACK_BARS}-bar mean,\n    excluding the bar itself. None when volume column missing OR lookback\n    would underflow.\n  - multi_tf_alignment: {level_id \u2192 \"with_segment\" | \"against\" | \"neutral\"}.\n    Always contains the primary level (always \"with_segment\" by trigger\n    construction). Foreign-TF entries appear only when their bars were\n    passed in and state could be computed.\n  - confidence: model-confidence score in [0, 1]; see _confidence() body.\n  - context_features: forward-compat extension dict (Z-roadmap analogues\n    of DivergenceSignal.context_features). None at v1.4.",
      "properties": {
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "candidate_bar_idx": {
          "minimum": 0,
          "title": "Candidate Bar Idx",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "top",
            "bottom"
          ],
          "title": "Direction",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "integer"
        },
        "segment_direction": {
          "title": "Segment Direction",
          "type": "string"
        },
        "bars_in_segment": {
          "minimum": 0,
          "title": "Bars In Segment",
          "type": "integer"
        },
        "n_completed_cycles": {
          "minimum": 0,
          "title": "N Completed Cycles",
          "type": "integer"
        },
        "wick_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Wick Ratio",
          "type": "number"
        },
        "body_half": {
          "enum": [
            "upper",
            "lower",
            "middle"
          ],
          "title": "Body Half",
          "type": "string"
        },
        "volume_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume Ratio"
        },
        "multi_tf_alignment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Multi Tf Alignment",
          "type": "object"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "context_features": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Features"
        }
      },
      "required": [
        "level_id",
        "timestamp",
        "candidate_bar_idx",
        "direction",
        "segment_id",
        "segment_direction",
        "bars_in_segment",
        "n_completed_cycles",
        "wick_ratio",
        "body_half",
        "volume_ratio",
        "multi_tf_alignment",
        "confidence"
      ],
      "title": "ExhaustionEvent",
      "type": "object"
    },
    "LevelFusionSummary": {
      "additionalProperties": false,
      "description": "Per-level fusion result (compact view).",
      "properties": {
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "trend_side": {
          "title": "Trend Side",
          "type": "string"
        },
        "close": {
          "title": "Close",
          "type": "number"
        },
        "dif": {
          "title": "Dif",
          "type": "number"
        },
        "dea": {
          "title": "Dea",
          "type": "number"
        },
        "hist": {
          "title": "Hist",
          "type": "number"
        },
        "ema52": {
          "title": "Ema52",
          "type": "number"
        },
        "form_confidences_local": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Form Confidences Local",
          "type": "object"
        },
        "form_confidences_fused": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Form Confidences Fused",
          "type": "object"
        },
        "sub_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sub Level"
        },
        "super_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Super Level"
        },
        "cycle_state": {
          "title": "Cycle State",
          "type": "string"
        },
        "segment_direction": {
          "title": "Segment Direction",
          "type": "string"
        },
        "hidden_subtype": {
          "title": "Hidden Subtype",
          "type": "string"
        },
        "near_zero_perfect": {
          "title": "Near Zero Perfect",
          "type": "boolean"
        }
      },
      "required": [
        "level_id",
        "timestamp",
        "trend_side",
        "close",
        "dif",
        "dea",
        "hist",
        "ema52",
        "form_confidences_local",
        "form_confidences_fused",
        "sub_level",
        "super_level",
        "cycle_state",
        "segment_direction",
        "hidden_subtype",
        "near_zero_perfect"
      ],
      "title": "LevelFusionSummary",
      "type": "object"
    },
    "PolicyDecisionDTO": {
      "additionalProperties": false,
      "description": "Pydantic mirror of dataclass PolicyDecision (which is frozen dataclass,\nnot pydantic). Lets the envelope dump to JSON cleanly.",
      "properties": {
        "weight": {
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "monitor_required": {
          "title": "Monitor Required",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "strategy_hints": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy Hints"
        }
      },
      "required": [
        "weight",
        "rule_id",
        "monitor_required",
        "reason"
      ],
      "title": "PolicyDecisionDTO",
      "type": "object"
    },
    "PriceSide": {
      "additionalProperties": false,
      "properties": {
        "reference_value": {
          "title": "Reference Value",
          "type": "number"
        },
        "candidate_value": {
          "title": "Candidate Value",
          "type": "number"
        },
        "is_new_extreme": {
          "title": "Is New Extreme",
          "type": "boolean"
        }
      },
      "required": [
        "reference_value",
        "candidate_value",
        "is_new_extreme"
      ],
      "title": "PriceSide",
      "type": "object"
    },
    "SignalOutput": {
      "additionalProperties": false,
      "description": "One divergence signal alongside the downstream policy result.\n\nConsumers needing only the raw signal can ignore `policy`. Consumers\nneeding a default weight read `policy.weight`. Consumers wanting to ignore\nrules entirely can read `signal.confidence` directly.",
      "properties": {
        "signal": {
          "$ref": "#/$defs/DivergenceSignal"
        },
        "policy": {
          "$ref": "#/$defs/PolicyDecisionDTO"
        }
      },
      "required": [
        "signal",
        "policy"
      ],
      "title": "SignalOutput",
      "type": "object"
    },
    "WindowSpec": {
      "additionalProperties": false,
      "description": "Time-range and bar-count summary for traceability.",
      "properties": {
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "bars_per_level": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Bars Per Level",
          "type": "object"
        }
      },
      "required": [
        "window_start",
        "window_end",
        "bars_per_level"
      ],
      "title": "WindowSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level envelope. ONE per symbol per analysis run.\n\nField guarantees:\n  - `schema_version`: always set, parseable by SemVer.\n  - `symbol`: uppercase ticker, no exchange prefix (e.g. \"SPY\" not\n    \"AMEX:SPY\"). Consumers should be exchange-agnostic.\n  - `system_ts`: UTC datetime when the analysis was computed.\n  - `window`: documents the input data span the analysis is based on.\n  - `cross_level`: current cross-TF synthesis (alignment + primary label).\n    May surface a \"stable\" label if nothing recent triggers.\n  - `levels`: per-TF state snapshots \u2014 len == number of TFs that had data.\n  - `signals`: list of divergence events DETECTED IN THE WINDOW (not just\n    the latest). Sorted by `signal.candidate_bar_idx` ascending.\n\nEmpty signals list is valid (means no divergence in window).",
  "properties": {
    "schema_version": {
      "default": "1.4",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "system_ts": {
      "format": "date-time",
      "title": "System Ts",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/WindowSpec"
    },
    "topology": {
      "default": "A",
      "title": "Topology",
      "type": "string"
    },
    "instrument_class": {
      "default": "us_equity",
      "title": "Instrument Class",
      "type": "string"
    },
    "cross_level": {
      "$ref": "#/$defs/CrossLevelSummaryDTO"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/LevelFusionSummary"
      },
      "title": "Levels",
      "type": "array"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/SignalOutput"
      },
      "title": "Signals",
      "type": "array"
    },
    "exhaustion_events": {
      "items": {
        "$ref": "#/$defs/ExhaustionEvent"
      },
      "title": "Exhaustion Events",
      "type": "array"
    }
  },
  "required": [
    "symbol",
    "system_ts",
    "window",
    "cross_level",
    "levels",
    "signals"
  ],
  "title": "AnalysisOutput",
  "type": "object"
}