{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/algotradinglife/paired-trading/doc/schemas/pa_feitian_evaluation_aggregate_result_v1.schema.json",
  "title": "PA / Feitian M6 Evaluation Aggregate Result v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "provenance", "evaluation_dataset", "groups", "walk_forward_folds", "warnings"],
  "properties": {"schema_version": {"const": "pa_feitian_evaluation_aggregate_result_v1"}, "generated_at_utc": {"type": "string", "format": "date-time"}, "provenance": {"$ref": "#/$defs/provenance"}, "evaluation_dataset": {"$ref": "#/$defs/dataset_ref"}, "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}, "walk_forward_folds": {"type": "array", "items": {"$ref": "#/$defs/walk_forward_fold"}}, "warnings": {"type": "array", "items": {"type": "string"}}},
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "hash_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["role", "source_manifest_path", "source_manifest_sha256", "source_manifest_schema_version", "premium_outcome_artifact_path", "premium_outcome_artifact_sha256", "premium_outcome_schema_version", "source_commit", "producer", "cli_args", "policy_config_sha256", "data_access_status", "fixture_fallback", "random_seed", "input_hashes", "output_hashes", "notes"], "properties": {"role": {"const": "m6_aggregate_result"}, "source_manifest_path": {"type": "string"}, "source_manifest_sha256": {"$ref": "#/$defs/hash"}, "source_manifest_schema_version": {"const": "pa_feitian_run_manifest_v1"}, "premium_outcome_artifact_path": {"type": "string"}, "premium_outcome_artifact_sha256": {"$ref": "#/$defs/hash"}, "premium_outcome_schema_version": {"const": "pa_feitian_premium_outcome_v1"}, "source_commit": {"type": "string", "minLength": 7, "maxLength": 40}, "producer": {"type": "string"}, "cli_args": {"type": "array", "items": {"type": "string"}}, "policy_config_sha256": {"$ref": "#/$defs/hash"}, "data_access_status": {"enum": ["real_data_available", "fixture_fallback", "data_blocked", "unknown"]}, "fixture_fallback": {"type": "boolean"}, "random_seed": {"type": ["integer", "null"]}, "input_hashes": {"$ref": "#/$defs/hash_map"}, "output_hashes": {"$ref": "#/$defs/hash_map"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "dataset_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "schema_version", "content_type"], "properties": {"kind": {"const": "evaluation_dataset"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"const": "pa_feitian_evaluation_dataset_v1"}, "content_type": {"const": "application/json"}}},
    "status_counts": {"type": "object", "additionalProperties": false, "required": ["observed", "ambiguous", "data_blocked", "not_evaluable"], "properties": {"observed": {"type": "integer", "minimum": 0}, "ambiguous": {"type": "integer", "minimum": 0}, "data_blocked": {"type": "integer", "minimum": 0}, "not_evaluable": {"type": "integer", "minimum": 0}}},
    "interval": {"type": "object", "additionalProperties": false, "required": ["confidence_level", "lower", "upper", "method", "cluster_unit"], "properties": {"confidence_level": {"type": "number", "minimum": 0, "maximum": 1}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}, "method": {"type": "string", "minLength": 1}, "cluster_unit": {"enum": ["event", "date", "none"]}}},
    "r_stats": {"type": "object", "additionalProperties": false, "required": ["mean", "median", "standard_deviation", "median_absolute_deviation", "lower_quantile", "worst_case", "win_rate", "win_definition", "bootstrap_95_ci"], "properties": {"mean": {"type": ["number", "null"]}, "median": {"type": ["number", "null"]}, "standard_deviation": {"type": ["number", "null"], "minimum": 0}, "median_absolute_deviation": {"type": ["number", "null"], "minimum": 0}, "lower_quantile": {"type": ["number", "null"]}, "worst_case": {"type": ["number", "null"]}, "win_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "win_definition": {"const": "premium_r_gt_zero"}, "bootstrap_95_ci": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["group_id", "dimension", "value", "result_status", "sample_count", "effective_sample_count", "status_counts", "premium_r", "underlying_r_correlation", "underlying_r_difference_mean", "notes"], "properties": {"group_id": {"type": "string"}, "dimension": {"enum": ["pooled", "pool", "underlying", "time_window", "trace_node", "policy"]}, "value": {"type": "string"}, "result_status": {"enum": ["generated", "insufficient_sample", "data_blocked", "not_evaluable"]}, "sample_count": {"type": "integer", "minimum": 0}, "effective_sample_count": {"type": "integer", "minimum": 0}, "status_counts": {"$ref": "#/$defs/status_counts"}, "premium_r": {"anyOf": [{"$ref": "#/$defs/r_stats"}, {"type": "null"}]}, "underlying_r_correlation": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "underlying_r_difference_mean": {"type": ["number", "null"]}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "walk_forward_fold": {"type": "object", "additionalProperties": false, "required": ["fold_id", "train_start_utc", "train_end_utc", "test_start_utc", "test_end_utc", "train_event_ids", "test_event_ids", "train_result", "test_result", "no_lookahead_verified", "notes"], "properties": {"fold_id": {"type": "string", "pattern": "^wf_[0-9]+$"}, "train_start_utc": {"type": "string", "format": "date-time"}, "train_end_utc": {"type": "string", "format": "date-time"}, "test_start_utc": {"type": "string", "format": "date-time"}, "test_end_utc": {"type": "string", "format": "date-time"}, "train_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "test_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "train_result": {"$ref": "#/$defs/group"}, "test_result": {"$ref": "#/$defs/group"}, "no_lookahead_verified": {"type": "boolean"}, "notes": {"type": "array", "items": {"type": "string"}}}}
  }
}
