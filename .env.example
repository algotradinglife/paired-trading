# Copy to .env and `source .env`.  See MIGRATION.md (§3 data, §4 secrets).
# Paths below are WSL/Linux examples — point them at the prepared data on this
# machine. A Windows drive shows up as /mnt/<letter>/...; a native WSL path
# (e.g. $HOME/data/...) is faster.

# --- data / output roots (override the in-repo src/data defaults) ---
export QUANT_ROOT="$HOME/data/paired-trading/quant"      # Parquet bar store (SHFE/DCE/CZCE/CFFEX/INE/NYSE)
export DERIVED_ROOT="$HOME/data/paired-trading/derived"  # backtest/review outputs
export MARKET_DATA="$HOME/data/paired-trading/market"    # used by drift_gate.sh + some fetch scripts

# --- credentials (only needed by data-fetch/prep scripts) ---
# The macOS-keychain helper scripts/_with_creds.sh does NOT work on WSL — set
# these directly here (or in ~/.bashrc) and run fetch scripts without that prefix.
export TQ_USERNAME=""          # TqSdk — CN futures + options intraday
export TQ_PASSWORD=""
export POLYGON_PROXY_URL=""    # Polygon proxy — US options
export POLYGON_PROXY_KEY=""
export QVERIS_API_KEY=""       # Qveris data source
export FMP_API_KEY=""          # FinancialModelingPrep data source

# --- optional / legacy (historical wiki task; not needed to run strategy+tests) ---
# export WIKI_ROOT="$HOME/data/paired-trading/wiki"
# export SAMPLES_ROOT="$HOME/data/paired-trading/samples"
