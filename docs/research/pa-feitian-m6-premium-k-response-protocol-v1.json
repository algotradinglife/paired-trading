  "causal_label_binding": {
    "protocol": "M6-EXP-012 causal proxy semantics are applied unchanged at the close of each completed daily decision bar.",
    "future_bars_for_labels": "forbidden",
    "controls": ["abstain", "conflict"],
    "controls_are_candidates": false
  },
  "response_matrix": {
    "eligible_structural_labels": [
      "long_left_touch",
      "long_right_break",
      "short_left_touch",
      "short_right_break",
      "long_invalidation",
      "short_invalidation"
    ],
    "mappings": {
      "long_left_touch": "upward",
      "long_right_break": "upward",
      "short_left_touch": "downward",
      "short_right_break": "downward",
      "long_invalidation": "downward",
      "short_invalidation": "upward"
    },
    "horizons_completed_daily_bars": [1, 3, 5],
    "response_formula": "direction_sign times (future_completed_close / decision_close minus 1), where direction_sign is +1 for upward and -1 for downward; no incomplete or substituted bar is admitted.",
    "missing_future_bar_action": "exclude_that_label_horizon_observation",
    "aggregation_unit": "all eligible observations from the fixed eight-series corpus; no series, product, label, horizon, or mapping is ranked"
  },
  "training_candidate_gate": {
    "minimum_observations": 20,
    "mean_signed_response": "strictly_positive",
    "median_signed_response": "strictly_positive",
    "clustered_bootstrap_ci": {
      "cluster": "hashed_series_identity",
      "resampling": "sample the observed series clusters with replacement and retain every eligible response in each selected cluster",
      "replicates": 2000,
      "seed": 7179,
      "confidence_level": 0.95,
      "statistic": "mean_signed_response",
      "quantile_rule": "linear interpolation at p times (n minus 1) in the sorted replicate values",
      "lower_bound_requirement": "greater_than_or_equal_to_zero"
    },
    "candidate_set_order": ["structural_label bytewise ascending", "horizon_completed_daily_bars numeric ascending"],
    "candidate_set_frozen_before_holdout": true,
    "no_survivor_action": "publish_negative_or_inconclusive_result_and_do_not_apply_holdout"
  },
