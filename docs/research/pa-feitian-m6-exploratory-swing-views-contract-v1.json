      "exchange": "SHFE",
      "product": "ag",
      "role": "continuity_candidate"
    },
    {
      "instrument_family": "CZCE.TA",
      "exchange": "CZCE",
      "product": "TA",
      "role": "mainstream_candidate"
    },
    {
