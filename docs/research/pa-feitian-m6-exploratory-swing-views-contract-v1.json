    },
    {
      "instrument_family": "DCE.i",
      "exchange": "DCE",
      "product": "i",
      "role": "non_czce_control"
    }
  ],
  "window_protocol": {
    "completed_observations": 20,
    "stride_observations": 20,
    "partition_scope": "within_each_anonymous_underlying_contract_series",
    "partial_final_window": "excluded",
    "post_audit_rows": "excluded_before_series_inventory_and_window_partitioning",
    "future_only_files": "excluded_from_source_inventory",
    "cross_contract_stitching": false,
    "cadence_resampling": false,
    "representative_quality": "clean_only",
    "representative_requires_daily_option_coverage": true,
    "representative_metric": "total_excursion_pct",
    "regime_percentile_targets": [
      {
        "label": "quiet",
        "percentile": 0.2
      },
      {
        "label": "typical",
        "percentile": 0.5
      },
      {
        "label": "volatile",
        "percentile": 0.8
      }
    ],
    "selection_scope": "within_family_only",
    "selection_uses_strategy_outcomes_or_profitability": false
  },
  "quality_protocol": {
    "required_fields": [
      "datetime",
      "open",
      "high",
      "low",
      "close"
    ],
    "activity_fields": [
      "volume",
      "turnover",
      "open_interest"
    ],
    "clean": "zero invalid observations and zero duplicate timestamps",
    "messy": "one through four invalid observations in a complete 20-observation window and zero duplicate timestamps",
    "invalid": "five or more invalid observations or any duplicate timestamp after the fixed pre-audit filter",
    "ohlc_coherence": "high >= low; high >= open and close; low <= open and close; all OHLC finite and strictly positive",
    "fresh_max_calendar_lag_days": 7,
    "freshness_uses_observation_date_not_filesystem_time": true
  },
  "descriptive_metrics": {
    "raw_price_values_in_public_output": false,
    "representative_path": {
      "bar_count": 20,
      "encoding": "each OHLC value divided by the first completed bar open and multiplied by 100",
      "bar_identity": "zero-based index only",
      "raw_dates_per_bar": false,
      "raw_ohlc_values": false
    },
    "normalized_window_metrics": [
      "net_change_pct",
      "total_excursion_pct",
      "realized_variability_annualized_pct",
      "median_bar_range_pct",
      "up_bar_share",
      "nonzero_activity_share"
    ],
    "strategy_outcome_fields": false,
    "profitability_interpretation": false
  },
  "option_premium_overlay": {
    "window_binding": "the frozen representative underlying family and date window",
    "selection_influence": false,
    "anonymous_series_only": true,
    "required_distinct_dates_for_comparable_path": 20,
    "required_dates": "exactly the 20 completed dates in the frozen underlying window",
    "duplicate_date_series_in_path_distribution": false,
    "incomplete_fragment_series_in_path_distribution": false,
    "coverage_length_distribution_published": true,
    "quality_status": {
      "clean": "zero null, nonfinite, nonpositive, or OHLC-incoherent observations",
      "messy": "positive violation share no greater than 0.2",
      "invalid": "violation share greater than 0.2 or no coherent observations"
    },
    "normalized_metrics": [
      "close_path_change_pct_distribution",
      "total_excursion_pct_distribution",
      "nonzero_activity_share",
      "input_quality_violation_share"
    ],
